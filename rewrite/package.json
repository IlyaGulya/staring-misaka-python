{
  "name": "staring-misaka",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests scripts package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json .prettierrc.json",
    "test": "bun test",
    "smoke:image": "bash scripts/smoke-image.sh",
    "import": "bun run src/import.ts",
    "observer-login": "bun run src/observer-login.ts"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "effect": "4.0.5",
    "grammy": "1.46.0",
    "telegram": "2.26.22"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
