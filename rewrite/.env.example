# Copy to .env locally; never commit credentials or an observer session.
# Shadow archives/classifies but does not execute Telegram moderation actions.
MODE=shadow
ALLOW_LIVE_MODERATION=false

BOT_TOKEN=
ADMIN_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Blank preserves the model from the existing YAML policy.
LLM_MODEL=
TELEGRAM_API_ROOT=https://api.telegram.org

# YAML provides the system prompt, per-chat instructions and default chat IDs.
# SPAM_CONFIG_FILE is the host bind mount used by compose.
SPAM_CONFIG_FILE=../config.yaml
# SPAM_CONFIG_PATH is used by direct Bun execution (compose overrides it).
SPAM_CONFIG_PATH=../config.yaml
# Optional comma-separated negative group IDs; blank uses YAML chats.
TRACKING_CHAT_IDS=

# Direct Bun paths; compose fixes these inside its nonroot writable named volume.
DB_PATH=./data/misaka.sqlite
JOURNAL_PATH=./data/events.jsonl

# A read-only observer covers messages Telegram bots cannot see, including other bots.
# Configure all three together. Obtain the session only via the explicit observer-login CLI.
# No observer is required for shadow. Live requires either all observer credentials
# OR an explicit acceptance of missing observer coverage below, as well as live opt-in above.
OBSERVER_API_ID=
OBSERVER_API_HASH=
OBSERVER_SESSION=
ACKNOWLEDGE_OBSERVER_GAP=false

# Optional Effect OTLP tracing endpoint. Empty disables trace export.
# Set the full collector traces URL only when you explicitly want telemetry export.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

POLL_TIMEOUT=25
CLASSIFICATION_CONCURRENCY=3
CLASSIFICATION_TIMEOUT_SECONDS=30
MAX_CLASSIFICATION_ATTEMPTS=3
MAX_ACTION_ATTEMPTS=5
RETRY_BASE_SECONDS=5
RECOVERY_INTERVAL_SECONDS=300
FOLLOWUP_TTL_SECONDS=60
