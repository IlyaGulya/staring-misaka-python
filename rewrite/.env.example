# Copy to .env locally; never commit credentials or an observer session.
# Shadow archives/classifies but does not execute Telegram moderation actions.
MODE=shadow
ALLOW_LIVE_MODERATION=false

BOT_TOKEN=
ADMIN_ID=

# Provider: openai (recommended: gpt-6-luna with reasoning=low) or anthropic (fallback)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=4096

# Anthropic fallback (only required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Blank selects gpt-6-luna for openai or the YAML model for anthropic.
LLM_MODEL=
TELEGRAM_API_ROOT=https://api.telegram.org

# Daily spend ceiling in USD (UTC day). 0 disables the budget guard.
DAILY_BUDGET_USD=5
# Soft reputation: skip LLM on plain unedited text after N substantive clean messages (0 = check all).
REPUTATION_THRESHOLD=5
REPUTATION_MIN_CHARS=30
# Scoped ban cleanup: delete cited evidence + messages from the last 24h (seconds).
BAN_CLEANUP_WINDOW_SECONDS=86400
# Automatically prune raw observations, exported audit rows and unused media older than N days (0 = off).
RETENTION_DAYS=30

# Admin DM comfort controls
ADMIN_BAN_NOTIFICATIONS=true
ADMIN_ALERTS=true

# Kubernetes / container health probes (0 disables the HTTP server)
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

# YAML provides the system prompt, per-chat instructions, names and default chat IDs.
SPAM_CONFIG_FILE=../config.yaml
SPAM_CONFIG_PATH=../config.yaml
TRACKING_CHAT_IDS=

# Direct Bun paths; compose/K8s set these inside the writable data volume.
DB_PATH=./data/misaka.sqlite
JOURNAL_PATH=./data/events.jsonl

# A read-only observer covers messages Telegram bots cannot see, including other bots.
OBSERVER_API_ID=
OBSERVER_API_HASH=
OBSERVER_SESSION=
ACKNOWLEDGE_OBSERVER_GAP=false

# Optional Effect OTLP tracing endpoint. Empty disables trace export.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

POLL_TIMEOUT=25
CLASSIFICATION_CONCURRENCY=3
CLASSIFICATION_TIMEOUT_SECONDS=30
MAX_CLASSIFICATION_ATTEMPTS=3
MAX_ACTION_ATTEMPTS=5
RETRY_BASE_SECONDS=5
RECOVERY_INTERVAL_SECONDS=300
FOLLOWUP_TTL_SECONDS=60
