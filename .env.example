# Telegram API credentials
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token

# Bot Super Admin User ID (your Telegram User ID)
ADMIN_ID=your_admin_user_id

# Database URL
# For async SQLite (local testing/small deployments):
DB_URL="sqlite+aiosqlite:///./staring_misaka.data/misaka.db"
# For PostgreSQL (recommended for production):
# DB_URL="postgresql+asyncpg://user:password@host:port/database"

# Anthropic API Key for Claude AI (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key
# OpenAI API Key (Optional)
# OPENAI_API_KEY=your_openai_api_key


# Bot session file path (can be relative to where the bot runs)
BOT_SESSION_PATH="staring_misaka.data/staring_misaka_bot.session"

# Prometheus metrics server port
PROMETHEUS_PORT=8000

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Default number of recent messages to delete when banning (can be overridden per group)
DEFAULT_BAN_MESSAGE_DELETION_LIMIT=10

# Gradio Web UI (Optional - if not set, UI runs without auth or on default port)
GRADIO_USERNAME=admin
GRADIO_PASSWORD=your_strong_password_here
GRADIO_PORT=7860