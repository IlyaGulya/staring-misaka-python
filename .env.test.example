# ============================================================================
# E2E Test Environment Variables for Telegram Test Servers
# ============================================================================
#
# This file contains the environment variables needed to run end-to-end
# integration tests against Telegram's official test servers (test.telegram.org).
#
# IMPORTANT:
# - These are TEST SERVER credentials, NOT production credentials
# - Test servers are completely isolated from production Telegram
# - You need separate test accounts and a test bot
#
# Setup Guide: See tests/E2E_SETUP.md for detailed instructions
#
# Quick Start:
# 1. Copy this file to .env.test
# 2. Generate StringSession for test user/admin (use scripts/generate_test_session.py)
#    (The script will display your API_ID/HASH as well)
# 3. Fill in the values below
# 4. Run: pixi run test-e2e
#

# ----------------------------------------------------------------------------
# Telegram Test Server API Credentials
# ----------------------------------------------------------------------------
# Get these from https://my.telegram.org (API development tools section)
TEST_API_ID=12345
TEST_API_HASH=your_api_hash_here

# ----------------------------------------------------------------------------
# Telegram Test Server Datacenter Configuration
# ----------------------------------------------------------------------------
# These settings determine which Telegram test server your E2E tests connect to.
# Default: DC2 (149.154.167.40:80) - Most commonly used test datacenter
#
# Available test datacenters:
#   DC1: 149.154.175.10:80
#   DC2: 149.154.167.40:80 (recommended)
#   DC3: 149.154.175.117:80
#
# IMPORTANT: These MUST be test server IPs. The kill-switch will prevent
# connections to production servers (any IP not starting with 149.154.*)
TEST_DATACENTER_IP=149.154.167.40
TEST_DATACENTER_PORT=80
TEST_DC_ID=2

# ----------------------------------------------------------------------------
# Test User Accounts (StringSession Format)
# ----------------------------------------------------------------------------
# Generate these using scripts/generate_test_session.py
#
# TEST_USER_SESSION: A regular user account for simulating spam/non-spam users
# This user will join groups, send messages, and get banned in tests
TEST_USER_SESSION=1BAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# TEST_ADMIN_SESSION: Admin user account for testing approval workflows
# This is the admin who will receive ban approval requests
# If not provided, TEST_USER_SESSION will be used for both roles
TEST_ADMIN_SESSION=1BAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# TEST_ADMIN_ID: User ID of the admin account
# This is the numeric ID of your TEST_ADMIN_SESSION user
# To get your user ID:
# 1. Use scripts/generate_test_session.py (it will print your user ID)
# 2. Or use @userinfobot on test servers
TEST_ADMIN_ID=123456789

# ----------------------------------------------------------------------------
# Test Bot Token (REQUIRED)
# ----------------------------------------------------------------------------
# Pre-created bot token from Telegram test servers
# Create a bot by running: pixi run python scripts/setup_test_bot.py
# This bot will be used for all E2E tests
TEST_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ----------------------------------------------------------------------------
# Optional: Test Log Channel
# ----------------------------------------------------------------------------
# If you want to test action logging to a separate channel:
# TEST_LOG_CHANNEL_MAP="-1001234567890:-1009876543210"
# Format: "group_id:log_channel_id,group2:log2"
